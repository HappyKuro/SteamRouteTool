<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- App id offered by the start-up prompt on a first run. 440 is Team Fortress 2.
             After that the tool remembers whatever was last chosen. -->
        <add key="appId" value="440" />
        <!-- Milliseconds to wait for an ICMP reply before a route counts as unreachable. -->
        <add key="pingTimeoutMs" value="1000" />
        <!-- How many routes are pinged at the same time. -->
        <add key="maxConcurrentPings" value="16" />
        <!-- Latency thresholds used to colour the ping column. -->
        <add key="goodPingMs" value="50" />
        <add key="fairPingMs" value="100" />
    </appSettings>
    <System.Windows.Forms.ApplicationConfigurationSection>
        <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
    </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
